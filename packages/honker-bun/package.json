    "@russellthehippo/honker-ext-linux-x64-gnu": "0.4.6",
    "@russellthehippo/honker-ext-linux-arm64-gnu": "0.4.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3"
  }
}

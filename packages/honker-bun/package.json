{
  "name": "@russellthehippo/honker-bun",
  "version": "0.4.2",
  "description": "Bun binding for Honker \u2014 durable queues, streams, pub/sub, and scheduler on SQLite.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://honker.dev",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",

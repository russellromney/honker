# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Node
node_modules/
*.node
# package-lock.json / bun.lock are deliberately NOT ignored — CI installs
# with `npm ci` / `bun install --frozen-lockfile`, which need a committed
# lockfile to pin against. Lockfiles are ignored by npm/bun when the
# package is consumed as a dependency, so committing them costs consumers
# nothing.
bun.lockb
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.python-version-local

# Rust
target/

# Coverage
coverage/
.coverage
.coverage.*
htmlcov/

# SQLite test databases / WAL / shared-memory
*.db
*.db-shm
*.db-wal

# Maturin / build
*.so
*.pyd
*.dylib
dist/
build/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Test output debris
test_out.txt
test_out2.txt

# Local scratchpads (project memory lives in ROADMAP.md / CHANGELOG.md)
PLAN.md
main.py

# Extension binaries staged into the honker-ext npm packages by
# scripts/copy-node-extension.sh. Built per release, never committed.
packages/honker-ext-npm/*/libhonker_ext.*
packages/honker-ext-npm/*/honker_ext.dll
packages/honker-node/libhonker_ext.*
